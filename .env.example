# ========== LLM (OpenRouter) ==========
LLM_API_KEY=sk-or-v1-your_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ========== Neo4j ==========
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ========== STT (faster-whisper, локально) ==========
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ========== App ==========
APP_HOST=0.0.0.0
APP_PORT=8000

# ========== n8n ==========
# Публичный URL туннеля (LocalTunnel / Cloudflare Tunnel)
WEBHOOK_URL=https://your-tunnel-url.loca.lt
